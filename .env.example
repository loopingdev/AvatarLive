# =============================================================================
# HUBIE 24/7 AI STREAMER - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. HOUSEBETS ACCOUNT CREDENTIALS (DEMO / ENTERTAINMENT MODE)
# -----------------------------------------------------------------------------
# The automated browser logs in to play all 14 House Originals in demo mode.
HOUSEBETS_EMAIL=your_email@example.com
HOUSEBETS_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# 2. OPENROUTER AI CONFIGURATION (LLM REASONING & NATURAL GPT-AUDIO TTS)
# -----------------------------------------------------------------------------
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM model for live commentary and chat responses:
# e.g., openai/gpt-oss-20b, google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# 3. VOICE ENGINE SETTINGS (OPENROUTER NATURAL STREAMER VOICE VS EDGE-TTS)
# -----------------------------------------------------------------------------
# Provider options:
# - openrouter: (RECOMMENDED) Uses OpenAI GPT-Audio model via your OpenRouter key.
#   Speaks with natural human vocal emotion, dynamic shouting, laughing, and crazy screams!
# - edge-tts: Free local Microsoft Edge neural TTS fallback.
TTS_PROVIDER=openrouter

# OpenRouter Audio Model & Voice Options:
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
# Voice options for gpt-audio-mini: onyx (masculine hype), alloy, echo, fable, nova, shimmer
OPENROUTER_VOICE=onyx

# Edge-TTS Fallback Settings (used if TTS_PROVIDER=edge-tts or if OpenRouter is offline):
VOICE_NAME=en-US-AndrewMultilingualNeural
VOICE_RATE=+3%
VOICE_PITCH=+0Hz

# -----------------------------------------------------------------------------
# 4. STREAMING DESTINATION & RTMP BROADCAST
# -----------------------------------------------------------------------------
# Stream platform: 'twitch' or 'kick'
STREAM_PLATFORM=twitch
# Your stream key from Twitch (dashboard.twitch.tv) or Kick (kick.com/dashboard/stream)
STREAM_KEY=live_xxxxxxxxxxxx
# Set true if using the built-in FFmpeg broadcaster directly to RTMP without OBS.
# Keep false if using OBS Studio (recommended for stream overlays).
ENABLE_RTMP_BROADCAST=false
STREAM_START_DELAY_SECONDS=90

# RTMP Ingest URLs
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
KICK_RTMP_URL=rtmp://fa7237973e61.global-contribute.live-video.net/app

# Broadcast resolution & bitrate (for built-in FFmpeg broadcaster)
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=60
VIDEO_BITRATE=4500k
AUDIO_BITRATE=160k

# -----------------------------------------------------------------------------
# 5. LIVE STREAM CHAT CHANNELS
# -----------------------------------------------------------------------------
# Channel usernames to listen for live viewer commands and questions.
# Leave blank to disable live chat ingestion.
TWITCH_CHANNEL=your_twitch_channel
KICK_CHANNEL=

# Set true ONLY if you want simulated test chat messages when offline
ENABLE_SIMULATED_CHAT=false

# -----------------------------------------------------------------------------
# 6. BROWSER AUTOMATION & GAMEPLAY SETTINGS
# -----------------------------------------------------------------------------
# Keep false on your local desktop to see Chrome in action.
# Set true if running without a visible Chrome window.
HEADLESS_BROWSER=false

# Number of rounds before automatically switching to the next House Original game
ROUNDS_PER_GAME=8

# Interval in seconds between responsible gambling reminders (18+ Begambleaware)
SAFETY_REMINDER_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# 7. WEB STUDIO & OBS OVERLAY SERVER
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
