# ==========================================
# HUBIE 24/7 AI STREAMER CONFIGURATION
# ==========================================

# Housebets Account Credentials
HOUSEBETS_EMAIL=your_email@example.com
HOUSEBETS_PASSWORD=your_password_here

# Real Live Stream Chat (Kick or Twitch channel name)
# Hubie will read and answer your real stream viewers!
KICK_CHANNEL=
TWITCH_CHANNEL=

# OpenRouter AI Credentials
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b

# Streaming Destination (Kick or Twitch)
STREAM_PLATFORM=kick
STREAM_KEY=
ENABLE_RTMP_BROADCAST=false

# Ingest URLs
KICK_RTMP_URL=rtmp://fa7237973e61.global-contribute.live-video.net/app

# Video & Studio Settings
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=60
VIDEO_BITRATE=4500k

# Hubie Voice Settings
VOICE_NAME=en-US-GuyNeural
VOICE_RATE=+8%
VOICE_PITCH=+4Hz

# Browser Visibility (false = visible Chrome window, true = headless)
HEADLESS_BROWSER=false
ROUNDS_PER_GAME=12

# Studio Web Server Port
PORT=8080
