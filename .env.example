# ==========================================
# HUBIE 24/7 AI STREAMER CONFIGURATION
# ==========================================

# Housebets Account Credentials
HOUSEBETS_EMAIL=your_email@example.com
HOUSEBETS_PASSWORD=your_password_here

# Real Live Stream Chat (Kick or Twitch channel name)
# Hubie connects to real chatrooms and answers live viewers!
KICK_CHANNEL=
TWITCH_CHANNEL=

# OpenRouter AI Credentials
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Streaming Destination (Kick or Twitch)
STREAM_PLATFORM=kick
STREAM_KEY=
ENABLE_RTMP_BROADCAST=false

# RTMP Ingest URLs
KICK_RTMP_URL=rtmp://fa7237973e61.global-contribute.live-video.net/app
TWITCH_RTMP_URL=rtmp://live.twitch.tv/app

# Video & Stream Encoding Settings
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=60
VIDEO_BITRATE=4500k
AUDIO_BITRATE=160k

# Hubie Character Voice Settings (Edge-TTS)
# en-US-EricNeural provides an animated, energetic character mascot voice
VOICE_NAME=en-US-EricNeural
VOICE_RATE=+6%
VOICE_PITCH=+3Hz

# Browser Visibility (false = visible Chrome window, true = headless for VPS/servers)
HEADLESS_BROWSER=false
ROUNDS_PER_GAME=12

# Safety & Moderation
SAFETY_REMINDER_INTERVAL_SECONDS=300

# Web Server & Telemetry
PORT=8080
HOST=0.0.0.0

